{
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/messaging?operation=notify"
    },
    {
      "source": "/api/broadcast",
      "destination": "/api/messaging?operation=broadcast"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-results",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 4 * * *"
    }
  ]
}
